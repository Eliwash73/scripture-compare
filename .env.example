# Bible API key — get a free one at https://scripture.api.bible
# Rename this file to .env.local and add your key
VITE_BIBLE_API_KEY=your_api_key_here

# Set to 'bible-api' (free, no key, fewer translations)
# or 'api-bible' (free key required, NIV/ESV/NLT/MSG available)
VITE_API_PROVIDER=bible-api
